create_table("event_streams") {
	t.Column("id", "uuid", {primary: true})
	t.Column("instance_id", "string", {})
	t.Column("animal_id", "integer", {})
	t.Column("event_type", "string", {})
	t.Column("payload", "json", {null: true})
	t.Column("source_db", "string", {})
	t.Column("imported_at", "timestamp", {})
	t.Column("processed_at", "timestamp", {null: true})
	t.Column("created_at", "timestamp", {})
}

add_index("event_streams", ["instance_id", "animal_id", "created_at"], {})
add_index("event_streams", ["processed_at"], {})
add_index("event_streams", ["source_db"], {})
